<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <title>About Us</title>
  <link rel="stylesheet" href="/style.css">
</head>

<body>
  <h1>Looping first 10 active processes</h1>
  <ul>
    $(foreach($i in (Get-Process | Select-Object -expandProperty Name -unique | Select-Object -first 10)){
    @"
    <li>$i</li>
    "@
    })
  </ul>
</body>

</html>